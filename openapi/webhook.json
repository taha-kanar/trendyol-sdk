  "paths": {
    "/sellers/{sellerId}/webhooks": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "Create Webhook - createWebhook",
        "description": "With this service, you can set up a webhook structure for your order packages.",
        "operationId": "createWebhook",
        "parameters": [
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Seller ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "authenticationType"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Webhook Service URL"
                  },
                  "username": {
                    "type": "string",
                    "description": "Username for Basic Authentication"
                  },
                  "password": {
                    "type": "string",
                    "description": "Password for Basic Authentication"
                  },
                  "authenticationType": {
                    "type": "string",
                    "description": "Can be BASIC_AUTHENTICATION or API_KEY",
                    "enum": [
                      "BASIC_AUTHENTICATION",
                      "API_KEY"
                    ]
                  },
                  "apiKey": {
                    "type": "string",
                    "description": "API Key for authorization"
                  },
                  "subscribedStatuses": {
                    "type": "array",
                    "description": "List of statuses for which order information is requested.\n\nIf sent empty, all statuses are automatically assigned:\n- CREATED\n- PICKING\n- INVOICED\n- SHIPPED\n- CANCELLED\n- DELIVERED\n- UNDELIVERED\n- RETURNED\n- UNSUPPLIED\n- AWAITING\n- UNPACKED\n- AT_COLLECTION_POINT\n- VERIFIED\n",
                    "items": {
                      "type": "string",
                      "enum": [
                        "CREATED",
                        "PICKING",
                        "INVOICED",
                        "SHIPPED",
                        "CANCELLED",
                        "DELIVERED",
                        "UNDELIVERED",
                        "RETURNED",
                        "UNSUPPLIED",
                        "AWAITING",
                        "UNPACKED",
                        "AT_COLLECTION_POINT",
                        "VERIFIED"
                      ]
                    }
                  }
                }
              },
              "example": {
                "url": "https://testwebhook.com",
                "username": "user",
                "password": "password",
                "authenticationType": "API_KEY",
                "apiKey": "123456",
                "subscribedStatuses": [
                  "CREATED",
                  "PICKING"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Webhook ID"
                    }
                  }
                },
                "example": {
                  "id": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Webhook"
        ],
        "summary": "List Webhooks - getWebhook",
        "description": "With this service, you can list the webhook methods you have previously created.",
        "operationId": "getWebhooks",
        "parameters": [
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Seller ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Webhook ID"
                      },
                      "createdDate": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Date when the webhook request was created (timestamp GMT +3)"
                      },
                      "lastModifiedDate": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true,
                        "description": "Date when the webhook request was last updated (timestamp GMT +3)"
                      },
                      "url": {
                        "type": "string",
                        "description": "Webhook Service URL"
                      },
                      "username": {
                        "type": "string",
                        "description": "Username for Basic Authentication"
                      },
                      "authenticationType": {
                        "type": "string",
                        "description": "Can be BASIC_AUTHENTICATION or API_KEY"
                      },
                      "status": {
                        "type": "string",
                        "description": "Can be ACTIVE or PASSIVE"
                      },
                      "subscribedStatuses": {
                        "type": "array",
                        "nullable": true,
                        "items": {
                          "type": "string"
                        },
                        "description": "List of statuses for which order information is requested"
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": "5297c986-6e09-4615-9f16-0deff65a0890",
                    "createdDate": 1733317686667,
                    "lastModifiedDate": 1734010262454,
                    "url": "https://testwebhook1.com",
                    "username": "test1",
                    "authenticationType": "BASIC_AUTHENTICATION",
                    "status": "PASSIVE",
                    "subscribedStatuses": [
                      "CREATED",
                      "CANCELLED",
                      "SHIPPED",
                      "DELIVERED",
                      "UNPACKED"
                    ]
                  },
                  {
                    "id": "4f9429b9-ef13-4d7c-94cf-9eee3ce7273a",
                    "createdDate": 1733917501531,
                    "lastModifiedDate": 1733920106237,
                    "url": "https://testwebhook2.com",
                    "username": "test2",
                    "authenticationType": "API_KEY",
                    "status": "PASSIVE",
                    "subscribedStatuses": null
                  },
                  {
                    "id": "2ba10e5d-5176-416b-9770-5d9c85a81a5e",
                    "createdDate": 1734087820902,
                    "lastModifiedDate": null,
                    "url": "https://testwebhook3.com",
                    "username": "test3",
                    "authenticationType": "API_KEY",
                    "status": "ACTIVE",
                    "subscribedStatuses": [
                      "CREATED",
                      "PICKING"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      }
    },
